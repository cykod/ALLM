{
  "name": "ALLM Dev",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22",
      "installYarnUsingApt": false,
    },
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.24",
    },
    "ghcr.io/rabdulwahhab/devcontainer-features/erlang-asdf:1": {
      "version": "27.1.2",
    },
    "ghcr.io/rabdulwahhab/devcontainer-features/elixir-asdf:1": {
      "version": "1.17.3-otp-27",
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
  },
  "mounts": [
    "source=${localEnv:HOME}/.claude/skills,target=/root/.claude/skills,type=bind,readonly",
  ],
  "postCreateCommand": "corepack enable && corepack prepare pnpm@10.28.1 --activate && npm install -g @playwright/cli@latest && playwright-cli install && asdf global erlang 27.1.2 && asdf global elixir 1.17.3-otp-27 && mix local.hex --force && mix local.rebar --force",
  "remoteUser": "root",
  "containerEnv": {
    "PLAYWRIGHT_BROWSERS_PATH": "/ms-playwright",
    "IS_SANDBOX": "1",
    "DEVCONTAINER": "1",
    "npm_config_yes": "true",
    "PNPM_YES": "true",
    "FORCE_COLOR": "1",
    // Stops `git status` from opportunistically rewriting `.git/index`.
    // Zed's remote server polls git ~1x/second and each poll rewrote the
    // index via lock+rename; on this virtiofs bind mount that rename
    // exposes a transient ENOENT window to concurrent readers (Zed logs
    // hitting it itself: "failed to read index ... no longer exists").
    // Git treats a MISSING index as an EMPTY one WITHOUT erroring, so a
    // `git add` landing in that window silently rebuilds a 1-entry index —
    // which is how a /milestone commit once recorded 1276 deletions.
    // Only *optional* locks are suppressed; `add`/`commit` still take
    // mandatory locks and are unaffected. Must be in containerEnv, not
    // remoteEnv: zed-remote-server is launched by `docker exec` and
    // inherits containerEnv (verified against /proc/<pid>/environ).
    "GIT_OPTIONAL_LOCKS": "0",
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "astro-build.astro-vscode",
        "bradlc.vscode-tailwindcss",
        "dbaeumer.vscode-eslint",
        "ms-playwright.playwright",
        "unifiedjs.vscode-mdx",
        "jakebecker.elixir-ls",
        "phoenixframework.phoenix",
      ],
    },
  },
}
